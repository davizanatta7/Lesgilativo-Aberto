<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Legislativo Aberto — Deputados, Senadores, Propostas e Gastos" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Legislativo Aberto">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">

    <link rel="icon" href="/favicon.ico?v=2" sizes="any">
    <link rel="icon" href="/icon.png?v=2" type="image/png">
    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
    <link rel="manifest" href="/manifest.json">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body>
    <header class="navbar">
      <div class="container navbar-content">
        <%= link_to root_path, class: "brand" do %>
          <div class="brand-logo-box">
            <img src="/icon.png?v=2" alt="Legislativo Aberto" class="brand-logo-img" width="42" height="42">
          </div>
          <div>
            <span class="brand-title">Legislativo<span class="brand-accent">Aberto</span></span>
            <span class="brand-subtitle">Transparência • Câmara &amp; Senado</span>
          </div>
        <% end %>

        <nav class="nav-links">
          <%= link_to parlamentares_path, class: "nav-link #{'active' if controller_name == 'parlamentares'}" do %>
            <span>👥 Parlamentares</span>
          <% end %>
          <%= link_to propostas_path, class: "nav-link #{'active' if controller_name == 'propostas'}" do %>
            <span>📜 Propostas &amp; PLs</span>
          <% end %>
        </nav>

        <div class="navbar-right">
          <%= form_with url: parlamentares_path, method: :get, local: true, class: "navbar-quick-search" do |f| %>
            <span class="navbar-search-icon">🔍</span>
            <%= f.search_field :q, value: params[:q], placeholder: "Buscar parlamentar ou partido...", class: "navbar-search-input" %>
          <% end %>
        </div>
      </div>
    </header>

    <main class="main-wrapper">
      <div class="container main-content">
        <% if notice.present? %>
          <div class="flash flash-notice" role="status">
            <span>✅ <%= notice %></span>
            <button type="button" class="flash-close" onclick="this.parentElement.remove()">✕</button>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="flash flash-alert" role="alert">
            <span>⚠️ <%= alert %></span>
            <button type="button" class="flash-close" onclick="this.parentElement.remove()">✕</button>
          </div>
        <% end %>

        <%= yield %>
      </div>
    </main>

    <footer class="footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <strong class="footer-brand-title">
            <img src="/icon.png?v=2" alt="" class="footer-logo-img" width="28" height="28">
            Legislativo Aberto
          </strong>
          <p>Plataforma de transparência pública para acompanhamento de Deputados Federais, Senadores, Projetos de Lei e Cota Parlamentar.</p>
        </div>
        <div class="footer-links">
          <span>Fontes Oficiais:</span>
          <a href="https://dadosabertos.camara.leg.br" target="_blank" rel="noopener">Dados Abertos da Câmara ↗</a>
          <a href="https://legis.senado.leg.br/dadosabertos" target="_blank" rel="noopener">Dados Abertos do Senado ↗</a>
          <a href="https://portaldatransparencia.gov.br" target="_blank" rel="noopener">Portal da Transparência ↗</a>
        </div>
      </div>
    </footer>

    <script>
      (function() {
        let activeController = null;
        let debounceTimer = null;

        function performLiveSearch(form) {
          const targetSelector = form.getAttribute("data-live-search-target");
          if (!targetSelector) return;

          const targetEl = document.querySelector(targetSelector);
          if (!targetEl) return;

          if (activeController) {
            activeController.abort();
          }
          activeController = new AbortController();

          const formData = new FormData(form);
          const params = new URLSearchParams();
          for (const [key, value] of formData.entries()) {
            if (value !== null && String(value).trim() !== "") {
              params.append(key, value);
            }
          }

          const baseUrl = form.getAttribute("action") || window.location.pathname;
          const queryString = params.toString();
          const url = queryString ? (baseUrl + "?" + queryString) : baseUrl;

          targetEl.classList.add("is-searching");

          fetch(url, {
            method: "GET",
            headers: {
              "Accept": "text/html",
              "X-Live-Search": "1"
            },
            signal: activeController.signal
          })
            .then(function(response) {
              if (!response.ok) throw new Error("Network error");
              return response.text();
            })
            .then(function(html) {
              const doc = new DOMParser().parseFromString(html, "text/html");
              const newTarget = doc.querySelector(targetSelector);
              if (newTarget) {
                targetEl.innerHTML = newTarget.innerHTML;
              }
              window.history.replaceState({}, "", url);
            })
            .catch(function(err) {
              if (err.name !== "AbortError") {
                console.warn("Erro na busca fluida:", err);
              }
            })
            .finally(function() {
              targetEl.classList.remove("is-searching");
            });
        }

        document.addEventListener("input", function(e) {
          const input = e.target.closest("[data-live-search-input]");
          if (!input) return;

          const form = input.closest("form[data-live-search-target]");
          if (!form) return;

          const clearBtn = form.querySelector("[data-live-search-clear]");
          if (clearBtn) {
            clearBtn.style.display = input.value.trim().length > 0 ? "" : "none";
          }

          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(function() {
            performLiveSearch(form);
          }, 180);
        });

        document.addEventListener("change", function(e) {
          const select = e.target.closest("[data-live-search-select]");
          if (!select) return;

          const form = select.closest("form[data-live-search-target]");
          if (!form) return;

          clearTimeout(debounceTimer);
          performLiveSearch(form);
        });

        document.addEventListener("click", function(e) {
          const clearBtn = e.target.closest("[data-live-search-clear]");
          if (!clearBtn) return;

          const form = clearBtn.closest("form[data-live-search-target]");
          if (!form) return;

          e.preventDefault();
          const input = form.querySelector("[data-live-search-input]");
          if (input) {
            input.value = "";
            input.focus();
          }
          clearBtn.style.display = "none";
          clearTimeout(debounceTimer);
          performLiveSearch(form);
        });
      })();
    </script>
  </body>
</html>
